<UserControl x:Class="Pos.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Pos.App.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="설정" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding SettingsStatusText}"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding SaveSettingsCommand}"
                        Content="설정 저장"
                        Style="{StaticResource LargePrimaryButtonStyle}" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="{StaticResource PagePadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,20" Text="상품 데이터" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Excel 데이터베이스" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox IsReadOnly="True"
                                     Text="{Binding DatabasePath, Mode=OneWay}"
                                     Style="{StaticResource PosTextBoxStyle}" />
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Button Margin="0,0,8,0"
                                        Command="{Binding SelectDatabaseCommand}"
                                        Content="파일 선택"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Margin="0,0,8,0"
                                        Command="{Binding TestDatabaseCommand}"
                                        Content="연결 테스트"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Command="{Binding ReloadDatabaseCommand}"
                                        Content="다시 불러오기"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                            <TextBlock Margin="0,12,0,0"
                                       Text="{Binding DatabaseStatusText}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,20" Text="스캐너" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="종료 키" Style="{StaticResource FieldLabelTextStyle}" />
                            <ComboBox ItemsSource="{Binding ScannerTerminatorOptions}"
                                      SelectedItem="{Binding SelectedScannerTerminator}"
                                      Style="{StaticResource PosComboBoxStyle}" />
                            <TextBlock Margin="0,16,0,8" Text="최대 입력 간격(ms)" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox InputMethod.IsInputMethodEnabled="False"
                                     Text="{Binding ScannerInputThresholdText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PosTextBoxStyle}" />
                            <CheckBox Margin="0,12,0,0"
                                      IsChecked="{Binding IsScanSoundEnabled}"
                                      Content="스캔 성공음"
                                      Style="{StaticResource PosCheckBoxStyle}" />
                            <TextBlock Margin="0,16,0,8" Text="품절 상품" Style="{StaticResource FieldLabelTextStyle}" />
                            <ComboBox ItemsSource="{Binding OutOfStockPolicyOptions}"
                                      SelectedItem="{Binding SelectedOutOfStockPolicy}"
                                      Style="{StaticResource PosComboBoxStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,20" Text="백업" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="백업 폴더" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox IsReadOnly="True"
                                     Text="{Binding BackupFolderPath, Mode=OneWay}"
                                     Style="{StaticResource PosTextBoxStyle}" />
                            <Button Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding SelectBackupFolderCommand}"
                                    Content="폴더 선택"
                                    Style="{StaticResource SecondaryButtonStyle}" />

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="주기" Style="{StaticResource FieldLabelTextStyle}" />
                                    <ComboBox ItemsSource="{Binding BackupFrequencyOptions}"
                                              SelectedItem="{Binding SelectedBackupFrequency}"
                                              Style="{StaticResource PosComboBoxStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="실행 시각" Style="{StaticResource FieldLabelTextStyle}" />
                                    <TextBox Text="{Binding BackupTimeText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource PosTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,16,0,8" Text="보존 개수" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBox InputMethod.IsInputMethodEnabled="False"
                                     Text="{Binding BackupRetentionCountText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource PosTextBoxStyle}" />

                            <WrapPanel Margin="0,16,0,0">
                                <Button Margin="0,0,8,8"
                                        Command="{Binding BackupNowCommand}"
                                        Content="지금 백업"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Margin="0,0,8,8"
                                        Command="{Binding OpenBackupFolderCommand}"
                                        Content="폴더 열기"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Margin="0,0,0,8"
                                        Command="{Binding ValidateBackupCommand}"
                                        Content="백업 검사"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </WrapPanel>
                            <TextBlock Margin="0,8,0,0"
                                       Text="{Binding LastBackupStatusText}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,20,0,0" Style="{StaticResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,20" Text="화면과 시작" Style="{StaticResource SectionTitleTextStyle}" />
                            <CheckBox IsChecked="{Binding IsStartFullscreen}"
                                      Content="전체 화면으로 시작"
                                      Style="{StaticResource PosCheckBoxStyle}" />
                            <CheckBox IsChecked="{Binding IsRunAtStartup}"
                                      Content="Windows 시작 시 실행"
                                      Style="{StaticResource PosCheckBoxStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <controls:BottomNavigation Grid.Row="2" />
    </Grid>
</UserControl>
