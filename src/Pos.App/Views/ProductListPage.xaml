<UserControl x:Class="Pos.App.Views.ProductListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Pos.App.Views.Controls">
    <UserControl.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Resources/Controls.xaml" />
        </ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1" Padding="20,12">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers><DataTrigger Binding="{Binding IsInputPanelVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="상품 목록" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Text="{Binding ProductCount, StringFormat={}{0:N0}개 상품}" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{Binding NoticeText}" Foreground="{StaticResource BrushTextPrimary}" Background="{StaticResource BrushSuccessTint}"
                               Padding="8,4" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}"><Setter Property="Margin" Value="0,4,0,0" /><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,8,0" Command="{Binding EditSelectedProductCommand}" Content="선택 상품 수정" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Command="{Binding AddProductCommand}" Content="상품 추가" Style="{StaticResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="16,12">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Padding="16" Margin="0,0,0,12">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                        <Style.Triggers><DataTrigger Binding="{Binding IsInputPanelVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="148" />
                        <ColumnDefinition Width="128" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="상품명 · 공급사 · 바코드" Style="{StaticResource FieldLabelTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox Tag="Search" AutomationProperties.Name="상품명, 공급사 또는 바코드 검색"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource PosTextBoxStyle}" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="한글" Command="{Binding ShowKoreanKeyboardCommand}" CommandParameter="Search"
                                    AutomationProperties.Name="검색용 한글 키보드 열기" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="카테고리" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" AutomationProperties.Name="카테고리 필터" Style="{StaticResource PosComboBoxStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="상태" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding ActiveStatusOptions}" SelectedItem="{Binding SelectedActiveStatus}" AutomationProperties.Name="판매 상태 필터" Style="{StaticResource PosComboBoxStyle}" />
                    </StackPanel>
                    <Button Grid.Column="3" Margin="0,25,0,0" Command="{Binding ClearSearchCommand}" Content="초기화" Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
            </Border>
            <Grid Grid.Row="1" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" IsReadOnly="True" AlternationCount="2"
                          AutomationProperties.Name="검색된 상품">
                    <DataGrid.Style>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource PosDataGridStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding IsEmpty}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="2*" MinWidth="180" Header="상품명">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        <TextBlock FontSize="12" Margin="0,3,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="판매 가능" /><Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Stock}" Value="{x:Null}"><Setter Property="Text" Value="재고 미관리" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Stock}" Value="0"><Setter Property="Text" Value="품절 · 재고 0" /><Setter Property="Foreground" Value="{StaticResource BrushError}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False"><Setter Property="Text" Value="판매 중지" /><Setter Property="Foreground" Value="{StaticResource BrushError}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="140" Header="가격" Binding="{Binding Price, StringFormat={}{0:N0}원}" ElementStyle="{StaticResource DataGridNumericTextStyle}" HeaderStyle="{StaticResource DataGridNumericColumnHeaderStyle}" />
                        <DataGridTextColumn Width="84" Header="재고" Binding="{Binding Stock, TargetNullValue=미관리, StringFormat={}{0:N0}}" ElementStyle="{StaticResource DataGridNumericTextStyle}" HeaderStyle="{StaticResource DataGridNumericColumnHeaderStyle}" />
                        <DataGridTextColumn Width="*" MinWidth="80" Header="공급사" Binding="{Binding Supplier}" ElementStyle="{StaticResource DataGridTextStyle}" />
                        <DataGridTextColumn Width="110" Header="카테고리" Binding="{Binding Category}" ElementStyle="{StaticResource DataGridTextStyle}" />
                        <DataGridTextColumn Width="160" Header="바코드" Binding="{Binding Barcode}" ElementStyle="{StaticResource DataGridTextStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding EmptyStateTitle}" HorizontalAlignment="Center" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding EmptyStateDescription}" MaxWidth="440" TextWrapping="Wrap" TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                <Style.Triggers><DataTrigger Binding="{Binding IsInputPanelVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button Margin="0,0,8,0" Command="{Binding EmptyStateActionCommand}" Content="{Binding EmptyStateActionText}" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button Command="{Binding DataContext.NavigateSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" Content="Excel 연결">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCatalogEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsInputPanelVisible}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Visibility="{Binding IsInputPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:KoreanKeyboard Margin="16,0,16,8" Visibility="{Binding IsKoreanKeyboardVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <controls:NumericKeypad Margin="16,0,16,8" Visibility="{Binding IsNumericKeypadVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
        <Border Grid.Row="3" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0" AutomationProperties.Name="{Binding SelectionStatusText}">
                    <TextBlock Text="{Binding SelectionTitle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionTitle}" Style="{StaticResource BodyTextStyle}" />
                    <TextBlock Text="{Binding SelectionHelpText}" TextWrapping="Wrap" Margin="0,3,0,0" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="수량" VerticalAlignment="Center" Margin="12,0,8,0" />
                <TextBox Grid.Column="2" Tag="Quantity" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="장바구니에 담을 수량" AutomationProperties.HelpText="{Binding QuantityError}"
                         ToolTip="{Binding QuantityError}" InputMethod.IsInputMethodEnabled="False" Style="{StaticResource PosTextBoxStyle}" />
                <Button Grid.Column="3" Margin="8,0" Content="숫자" Command="{Binding ShowNumericKeypadCommand}" CommandParameter="Quantity"
                        AutomationProperties.Name="수량 키패드 열기" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="4" Content="장바구니 담기" Command="{Binding AddToCartCommand}" ToolTip="담은 뒤 판매 화면으로 돌아갑니다. Ctrl+Enter" Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Border>
        <controls:BottomNavigation Grid.Row="4" />
    </Grid>
</UserControl>
