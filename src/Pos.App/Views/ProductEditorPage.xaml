<UserControl x:Class="Pos.App.Views.ProductEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Pos.App.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280" SizeChanged="OnPageSizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle, FallbackValue=상품 추가}"
                               Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding EditorFeedbackText}"
                               Style="{StaticResource ValidationFeedbackTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"
                            Content="취소"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Command="{Binding SaveProductCommand}"
                            Content="저장"
                            Style="{StaticResource LargePrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid x:Name="EditorFormGrid" Margin="{StaticResource PagePadding}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="EditorColumnGap" Width="24" />
                    <ColumnDefinition x:Name="EditorSecondaryColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,20"
                                   Text="기본 정보"
                                   Style="{StaticResource SectionTitleTextStyle}" />

                        <TextBlock Text="상품명 *" Style="{StaticResource FieldLabelTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox AutomationProperties.Name="상품명" AutomationProperties.HelpText="{Binding ProductNameError}" Tag="ProductName"

                                 Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource PosTextBoxStyle}" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="한글" Command="{Binding ShowKoreanKeyboardCommand}" CommandParameter="ProductName" AutomationProperties.Name="상품명 키보드 열기" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                        <TextBlock Text="{Binding ProductNameError}" Style="{StaticResource ErrorTextStyle}" />

                        <TextBlock Margin="0,16,0,8" Text="가격 (원) *" Style="{StaticResource FieldLabelTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox AutomationProperties.Name="가격 (원)" AutomationProperties.HelpText="{Binding PriceError}" Tag="Price"

                                 InputMethod.IsInputMethodEnabled="False"
                                 Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource PosTextBoxStyle}" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="숫자" Command="{Binding ShowNumericKeypadCommand}" CommandParameter="Price" AutomationProperties.Name="가격 (원) 키보드 열기" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                        <TextBlock Text="{Binding PriceError}" Style="{StaticResource ErrorTextStyle}" />

                        <TextBlock Margin="0,16,0,8" Text="바코드" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox AutomationProperties.Name="바코드" Tag="Barcode" AutomationProperties.HelpText="{Binding BarcodeError}"
                                 Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource PosTextBoxStyle}" />
                        <TextBlock Text="{Binding BarcodeError}" Style="{StaticResource ErrorTextStyle}" />

                        <TextBlock Margin="0,16,0,8" Text="공급사" Style="{StaticResource FieldLabelTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox AutomationProperties.Name="공급사" AutomationProperties.HelpText="{Binding SupplierError}" Tag="Supplier"

                                 Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PosTextBoxStyle}" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="한글" Command="{Binding ShowKoreanKeyboardCommand}" CommandParameter="Supplier" AutomationProperties.Name="공급사 키보드 열기" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                        <TextBlock Text="{Binding SupplierError}" Style="{StaticResource ErrorTextStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="EditorSecondaryPanel" Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,20"
                                   Text="분류와 재고"
                                   Style="{StaticResource SectionTitleTextStyle}" />

                        <TextBlock Text="재고 (비우면 미관리)" Style="{StaticResource FieldLabelTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox AutomationProperties.Name="재고" AutomationProperties.HelpText="{Binding StockError}" Tag="Stock"

                                 InputMethod.IsInputMethodEnabled="False"
                                 Text="{Binding StockText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource PosTextBoxStyle}" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="숫자" Command="{Binding ShowNumericKeypadCommand}" CommandParameter="Stock" AutomationProperties.Name="재고 키보드 열기" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                        <TextBlock Text="{Binding StockError}" Style="{StaticResource ErrorTextStyle}" />

                        <TextBlock Margin="0,16,0,8" Text="카테고리" Style="{StaticResource FieldLabelTextStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox AutomationProperties.Name="카테고리" Tag="Category" AutomationProperties.HelpText="{Binding CategoryError}" IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Text="{Binding CategoryText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                  Style="{StaticResource PosComboBoxStyle}" />
                            <Button Grid.Column="1" Margin="8,0,0,0" Content="한글" Command="{Binding ShowKoreanKeyboardCommand}"
                                    CommandParameter="Category" AutomationProperties.Name="카테고리 키보드 열기" Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                        <TextBlock Text="{Binding CategoryError}" Style="{StaticResource ErrorTextStyle}" />

                        <Border Margin="0,20,0,0"
                                Padding="16"
                                Background="{StaticResource BrushSurfaceMuted}"
                                CornerRadius="{StaticResource RadiusControl}">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IsQuickAdd}"
                                          Content="빠른 추가에 표시"
                                          Style="{StaticResource PosCheckBoxStyle}" />
                                <CheckBox IsChecked="{Binding IsActive}"
                                          Content="판매 가능한 상품"
                                          Style="{StaticResource PosCheckBoxStyle}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <controls:BottomNavigation Grid.Row="3" />

        <StackPanel Grid.Row="2" Visibility="{Binding IsInputPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:KoreanKeyboard Margin="16,0,16,8" Visibility="{Binding IsKoreanKeyboardVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <controls:NumericKeypad Margin="16,0,16,8" Visibility="{Binding IsNumericKeypadVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>
    </Grid>
</UserControl>
