<UserControl x:Class="Pos.App.Views.ProductEditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Pos.App.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding EditorTitle, FallbackValue=상품 추가}"
                               Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock Margin="0,4,0,0"
                               Text="{Binding EditorStatusText}"
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding CancelCommand}"
                            Content="취소"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Command="{Binding SaveProductCommand}"
                            Content="저장"
                            Style="{StaticResource LargePrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="{StaticResource PagePadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,20"
                                   Text="기본 정보"
                                   Style="{StaticResource SectionTitleTextStyle}" />

                        <TextBlock Text="상품명" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Tag="ProductName"
                                 GotKeyboardFocus="OnKoreanInputGotKeyboardFocus"
                                 Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource PosTextBoxStyle}" />
                        <TextBlock Text="{Binding ProductNameError}" Style="{StaticResource ErrorTextStyle}" />

                        <TextBlock Margin="0,16,0,8" Text="가격" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Tag="Price"
                                 GotKeyboardFocus="OnNumericInputGotKeyboardFocus"
                                 InputMethod.IsInputMethodEnabled="False"
                                 Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource PosTextBoxStyle}" />
                        <TextBlock Text="{Binding PriceError}" Style="{StaticResource ErrorTextStyle}" />

                        <TextBlock Margin="0,16,0,8" Text="바코드" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource PosTextBoxStyle}" />
                        <TextBlock Text="{Binding BarcodeError}" Style="{StaticResource ErrorTextStyle}" />

                        <TextBlock Margin="0,16,0,8" Text="공급사" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Tag="Supplier"
                                 GotKeyboardFocus="OnKoreanInputGotKeyboardFocus"
                                 Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource PosTextBoxStyle}" />
                        <TextBlock Text="{Binding SupplierError}" Style="{StaticResource ErrorTextStyle}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,20"
                                   Text="분류와 재고"
                                   Style="{StaticResource SectionTitleTextStyle}" />

                        <TextBlock Text="재고" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Tag="Stock"
                                 GotKeyboardFocus="OnNumericInputGotKeyboardFocus"
                                 InputMethod.IsInputMethodEnabled="False"
                                 Text="{Binding StockText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                 Style="{StaticResource PosTextBoxStyle}" />
                        <TextBlock Text="{Binding StockError}" Style="{StaticResource ErrorTextStyle}" />

                        <TextBlock Margin="0,16,0,8" Text="카테고리" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Text="{Binding CategoryText, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource PosComboBoxStyle}" />
                        <TextBlock Text="{Binding CategoryError}" Style="{StaticResource ErrorTextStyle}" />

                        <Border Margin="0,20,0,0"
                                Padding="16"
                                Background="{StaticResource BrushSurfaceMuted}"
                                CornerRadius="{StaticResource RadiusControl}">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IsQuickAdd}"
                                          Content="빠른 추가에 표시"
                                          Style="{StaticResource PosCheckBoxStyle}" />
                                <CheckBox IsChecked="{Binding IsActive}"
                                          Content="판매 가능한 상품"
                                          Style="{StaticResource PosCheckBoxStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,20,0,0"
                                Padding="16"
                                Background="{StaticResource BrushWarningTint}"
                                BorderBrush="{StaticResource BrushWarning}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusControl}"
                                Visibility="{Binding HasValidationSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Foreground="{StaticResource BrushTextPrimary}"
                                       Text="{Binding ValidationSummary}"
                                       TextWrapping="Wrap"
                                       Style="{StaticResource BodyTextStyle}" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <controls:BottomNavigation Grid.Row="2" />

        <Grid Grid.RowSpan="3"
              Panel.ZIndex="100"
              Visibility="{Binding IsInputPanelVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button Background="#660A0A0A"
                    BorderThickness="0"
                    Command="{Binding DismissInputPanelCommand}"
                    Focusable="False" />
            <controls:KoreanKeyboard Margin="24"
                                     VerticalAlignment="Bottom"
                                     Visibility="{Binding IsKoreanKeyboardVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <controls:NumericKeypad Margin="24"
                                    VerticalAlignment="Bottom"
                                    Visibility="{Binding IsNumericKeypadVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</UserControl>
