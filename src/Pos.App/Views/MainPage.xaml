<UserControl x:Class="Pos.App.Views.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Pos.App.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280"
             SizeChanged="OnMainPageSizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BrushBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ApplicationName, FallbackValue=Simple POS}"
                               Style="{StaticResource PageTitleTextStyle}" />
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                        <TextBlock Text="DB"
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Margin="6,0,20,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding DatabaseStatusText, FallbackValue=연결 확인 필요}"
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="백업"
                                   Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Margin="6,0,0,0"
                                   FontWeight="SemiBold"
                                   Text="{Binding BackupStatusText, FallbackValue=상태 확인 필요}"
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource FontMono}"
                           FontSize="17"
                           Foreground="{StaticResource BrushTextSecondary}"
                           Text="{Binding CurrentTimeText, FallbackValue=--:--}" />
            </Grid>
        </Border>

        <Grid x:Name="AdaptiveWorkspace"
              Grid.Row="1"
              Margin="{StaticResource PagePadding}">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="WorkspacePrimaryRow" Height="*" />
                <RowDefinition x:Name="WorkspaceSecondaryRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WorkspacePrimaryColumn" Width="3*" />
                <ColumnDefinition x:Name="WorkspaceSecondaryColumn" Width="2*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CartPanel"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="장바구니"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding TotalItemCount, StringFormat={}{0:N0}개}"
                                   Style="{StaticResource MutedTextStyle}" />
                    </DockPanel>

                    <Grid Grid.Row="1"
                          Margin="8,0,8,4"
                          MinHeight="36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="156" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="104" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="상품" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="단가" TextAlignment="Right" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="수량" TextAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="금액" TextAlignment="Right" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="작업" TextAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListView ItemsSource="{Binding CartItems}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource PosFocusVisualStyle}" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="64" Margin="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   ToolTip="{Binding Name}"
                                                   Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding UnitPrice, StringFormat={}{0:N0}원}"
                                                   TextAlignment="Right"
                                                   Style="{StaticResource BodyTextStyle}" />
                                        <Button Grid.Column="2"
                                                Margin="2"
                                                Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Content="−"
                                                ToolTip="수량 줄이기"
                                                Style="{StaticResource QuantityButtonStyle}" />
                                        <TextBlock Grid.Column="3"
                                                   VerticalAlignment="Center"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Quantity}"
                                                   TextAlignment="Center"
                                                   Style="{StaticResource BodyTextStyle}" />
                                        <Button Grid.Column="4"
                                                Margin="2"
                                                Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Content="+"
                                                ToolTip="수량 늘리기"
                                                Style="{StaticResource QuantityButtonStyle}" />
                                        <TextBlock Grid.Column="5"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding LineTotal, StringFormat={}{0:N0}원}"
                                                   TextAlignment="Right"
                                                   Style="{StaticResource BodyTextStyle}" />
                                        <Button Grid.Column="6"
                                                Margin="4,2"
                                                Command="{Binding DataContext.EditCartItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="상품 수정"
                                                ToolTip="상품 정보 수정"
                                                Style="{StaticResource GhostButtonStyle}">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="18" Text="&#xE70F;" />
                                        </Button>
                                        <Button Grid.Column="7"
                                                Margin="4,2"
                                                Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="목록에서 제거"
                                                ToolTip="목록에서 제거"
                                                Style="{StaticResource GhostButtonStyle}">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="18" Text="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Text="장바구니가 비어 있습니다."
                                   Visibility="{Binding IsCartEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Style="{StaticResource MutedTextStyle}" />
                    </Grid>

                    <Border Grid.Row="3"
                            Margin="0,16,0,0"
                            Padding="16"
                            Background="{StaticResource BrushSurfaceMuted}"
                            CornerRadius="{StaticResource RadiusControl}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="총 결제 금액" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0}원}"
                                           Style="{StaticResource AmountTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Margin="0,0,8,0"
                                        Command="{Binding ClearCartCommand}"
                                        Content="장바구니 비우기"
                                        Style="{StaticResource DangerButtonStyle}" />
                                <Button Command="{Binding CompleteSaleCommand}"
                                        Content="판매 완료"
                                        Style="{StaticResource LargePrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="QuickAddPanel"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10"
                               LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="빠른 추가"
                                   Style="{StaticResource SectionTitleTextStyle}" />
                        <Button DockPanel.Dock="Right"
                                MinHeight="40"
                                Padding="12,0"
                                AutomationProperties.Name="빠른 추가 상품 등록"
                                Command="{Binding AddQuickProductCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                ToolTip="빠른 추가 상품 등록">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,8,0"
                                           FontFamily="Segoe Fluent Icons"
                                           FontSize="16"
                                           Text="&#xE710;" />
                                <TextBlock Text="상품 등록" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding QuickAddItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.AddQuickItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource QuickAddTileButtonStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Name}"
                                                       TextAlignment="Left"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="Wrap"
                                                       ToolTip="{Binding Name}"
                                                       Style="{StaticResource BodyTextStyle}" />
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,8,0,0"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Price, StringFormat={}{0:N0}원}"
                                                       TextAlignment="Right"
                                                       Style="{StaticResource BodyTextStyle}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <controls:BottomNavigation Grid.Row="2" />
    </Grid>
</UserControl>
