<UserControl x:Class="Pos.App.Views.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Pos.App.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280"
             SizeChanged="OnMainPageSizeChanged">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="BrushPosHeader" Color="#1A283E" />
            <SolidColorBrush x:Key="BrushPosHeaderMuted" Color="#B9C3D2" />
            <SolidColorBrush x:Key="BrushPosWorkspace" Color="#EFEFF4" />
            <SolidColorBrush x:Key="BrushPosAction" Color="#006DFF" />
            <SolidColorBrush x:Key="BrushPosActionHover" Color="#005AD6" />
            <SolidColorBrush x:Key="BrushPosActionPressed" Color="#0049B0" />
            <SolidColorBrush x:Key="BrushPosBrandAccent" Color="#F4D35E" />

            <Style x:Key="MainSearchButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource PosButtonBaseStyle}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Background" Value="{StaticResource BrushPosHeader}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushPosHeader}" />
                <Setter Property="Foreground" Value="White" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#243653" />
                        <Setter Property="BorderBrush" Value="#243653" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#101D30" />
                        <Setter Property="BorderBrush" Value="#101D30" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MainLinkButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource GhostButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource BrushPosAction}" />
                <Setter Property="MinHeight" Value="44" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#EAF2FF" />
                        <Setter Property="Foreground" Value="{StaticResource BrushPosActionHover}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MainActionButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource PosButtonBaseStyle}">
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="Background" Value="{StaticResource BrushPosAction}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushPosAction}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="17" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushPosActionHover}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BrushPosActionHover}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource BrushPosActionPressed}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BrushPosActionPressed}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CheckoutPanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushSurface}" />
                <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusPanel}" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BrushPosWorkspace}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Height="64"
                Background="{StaticResource BrushPosHeader}"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="18"
                            Height="24"
                            Margin="0,0,12,0"
                            Background="{StaticResource BrushPosBrandAccent}"
                            CornerRadius="2" />
                    <TextBlock VerticalAlignment="Center"
                               FontFamily="{StaticResource FontDisplay}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="{Binding ApplicationName, FallbackValue=Simple POS}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Ellipse Width="10"
                             Height="10"
                             Margin="0,0,8,0"
                             Fill="{StaticResource BrushSuccess}" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="영업중" />
                    <Border Width="1"
                            Height="20"
                            Margin="16,0"
                            Background="#40506A" />
                    <TextBlock MaxWidth="200"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource BrushPosHeaderMuted}"
                               Text="{Binding DatabaseStatusText, FallbackValue=DB 확인 필요}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding DatabaseStatusText}" />
                    <TextBlock Margin="16,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource BrushPosHeaderMuted}"
                               Text="{Binding BackupStatusText, StringFormat=백업 {0}}" />
                    <TextBlock Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="{Binding CurrentTimeText, FallbackValue=--:--}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="AdaptiveWorkspace" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="WorkspacePrimaryRow" Height="*" />
                <RowDefinition x:Name="WorkspaceSecondaryRow" Height="0" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="WorkspacePrimaryColumn" Width="3*" />
                <ColumnDefinition x:Name="WorkspaceSecondaryColumn" Width="2*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CartPanel"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Background="{StaticResource BrushSurface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Height="64"
                            Background="{StaticResource BrushPosWorkspace}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource FontDisplay}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextPrimary}"
                                           Text="장바구니" />
                                <TextBlock Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding TotalItemCount, StringFormat={}{0:N0}개}"
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    AutomationProperties.Name="상품 찾기"
                                    Command="{Binding DataContext.NavigateProductListCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    Style="{StaticResource MainSearchButtonStyle}"
                                    ToolTip="상품 목록 열기">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="17"
                                               Text="&#xE721;" />
                                    <TextBlock Text="상품 찾기" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1"
                          MinHeight="44"
                          Margin="20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="156" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="104" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="상품" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="단가" TextAlignment="Right" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="수량" TextAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="금액" TextAlignment="Right" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="작업" TextAlignment="Center" Style="{StaticResource MutedTextStyle}" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="12,0">
                        <ListView ItemsSource="{Binding CartItems}"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource PosFocusVisualStyle}" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="64" Margin="8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   ToolTip="{Binding Name}"
                                                   Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding UnitPrice, StringFormat={}{0:N0}원}"
                                                   TextAlignment="Right"
                                                   Style="{StaticResource BodyTextStyle}" />
                                        <Button Grid.Column="2"
                                                Margin="2"
                                                Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Content="−"
                                                ToolTip="수량 줄이기"
                                                Style="{StaticResource QuantityButtonStyle}" />
                                        <TextBlock Grid.Column="3"
                                                   VerticalAlignment="Center"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Quantity}"
                                                   TextAlignment="Center"
                                                   Style="{StaticResource BodyTextStyle}" />
                                        <Button Grid.Column="4"
                                                Margin="2"
                                                Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                Content="+"
                                                ToolTip="수량 늘리기"
                                                Style="{StaticResource QuantityButtonStyle}" />
                                        <TextBlock Grid.Column="5"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding LineTotal, StringFormat={}{0:N0}원}"
                                                   TextAlignment="Right"
                                                   Style="{StaticResource BodyTextStyle}" />
                                        <Button Grid.Column="6"
                                                Margin="4,2"
                                                Command="{Binding DataContext.EditCartItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="상품 수정"
                                                ToolTip="상품 정보 수정"
                                                Style="{StaticResource GhostButtonStyle}">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="18" Text="&#xE70F;" />
                                        </Button>
                                        <Button Grid.Column="7"
                                                Margin="4,2"
                                                Command="{Binding DataContext.RemoveCartItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="목록에서 제거"
                                                ToolTip="목록에서 제거"
                                                Style="{StaticResource GhostButtonStyle}">
                                            <TextBlock FontFamily="Segoe Fluent Icons" FontSize="18" Text="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsCartEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Text="장바구니가 비어 있습니다." />
                            <Button Margin="0,16,0,0"
                                    Command="{Binding DataContext.NavigateProductListCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    Style="{StaticResource MainLinkButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="17"
                                               Text="&#xE721;" />
                                    <TextBlock Text="상품 찾기" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="CompactCheckoutPanel"
                            Grid.Row="3"
                            Margin="16,12,16,16"
                            Style="{StaticResource CheckoutPanelStyle}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="총 결제 금액" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0}원}"
                                           Style="{StaticResource AmountTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Margin="0,0,8,0"
                                        AutomationProperties.Name="장바구니 비우기"
                                        Command="{Binding ClearCartCommand}"
                                        Style="{StaticResource DangerButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" FontSize="17" Text="&#xE74D;" />
                                        <TextBlock Text="비우기" />
                                    </StackPanel>
                                </Button>
                                <Button MinWidth="160"
                                        Command="{Binding CompleteSaleCommand}"
                                        Content="판매 완료"
                                        Style="{StaticResource MainActionButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="QuickAddPanel"
                  Grid.Row="0"
                  Grid.Column="1"
                  Margin="8,0,0,0"
                  Background="{StaticResource BrushPosWorkspace}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="20,16,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource FontDisplay}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   Text="빠른 추가" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding QuickAddItems.Count, StringFormat={}{0:N0}개 상품}"
                                   Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            MinHeight="44"
                            Padding="14,0"
                            AutomationProperties.Name="빠른 추가 상품 등록"
                            Command="{Binding AddQuickProductCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            ToolTip="빠른 추가 상품 등록">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0"
                                       FontFamily="Segoe Fluent Icons"
                                       FontSize="16"
                                       Text="&#xE710;" />
                            <TextBlock Text="상품 등록" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="14,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding QuickAddItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.AddQuickItemCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource QuickAddTileButtonStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   TextAlignment="Left"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding Name}"
                                                   Style="{StaticResource BodyTextStyle}" />
                                        <TextBlock Grid.Row="1"
                                                   Margin="0,8,0,0"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Price, StringFormat={}{0:N0}원}"
                                                   TextAlignment="Right"
                                                   Style="{StaticResource BodyTextStyle}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border x:Name="DesktopCheckoutPanel"
                        Grid.Row="2"
                        Margin="20,12,20,16"
                        Style="{StaticResource CheckoutPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="총 결제 금액" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0}원}"
                                           Style="{StaticResource AmountTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="장바구니 비우기"
                                    Command="{Binding ClearCartCommand}"
                                    Style="{StaticResource DangerButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,8,0" FontFamily="Segoe Fluent Icons" FontSize="17" Text="&#xE74D;" />
                                    <TextBlock Text="비우기" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Button Grid.Row="1"
                                Margin="0,12,0,0"
                                HorizontalContentAlignment="Center"
                                Command="{Binding CompleteSaleCommand}"
                                Content="판매 완료"
                                Style="{StaticResource MainActionButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <controls:BottomNavigation Grid.Row="2" />
    </Grid>
</UserControl>
