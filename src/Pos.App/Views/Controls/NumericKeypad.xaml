<UserControl x:Class="Pos.App.Views.Controls.NumericKeypad"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="360"
             d:DesignWidth="440">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Width="420"
            HorizontalAlignment="Center"
            Style="{StaticResource PanelBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Margin="4,0,4,8"
                       Text="숫자 키패드"
                       Style="{StaticResource SectionTitleTextStyle}" />

            <UniformGrid Grid.Row="1" Columns="4">
                <Button Command="{Binding NumericKeyCommand}" CommandParameter="7" Content="7" Style="{StaticResource KeyboardKeyButtonStyle}" />
                <Button Command="{Binding NumericKeyCommand}" CommandParameter="8" Content="8" Style="{StaticResource KeyboardKeyButtonStyle}" />
                <Button Command="{Binding NumericKeyCommand}" CommandParameter="9" Content="9" Style="{StaticResource KeyboardKeyButtonStyle}" />
                <Button Command="{Binding NumericBackspaceCommand}" Content="지우기" Style="{StaticResource KeyboardKeyButtonStyle}" />
            </UniformGrid>
            <UniformGrid Grid.Row="2" Columns="4">
                <Button Command="{Binding NumericKeyCommand}" CommandParameter="4" Content="4" Style="{StaticResource KeyboardKeyButtonStyle}" />
                <Button Command="{Binding NumericKeyCommand}" CommandParameter="5" Content="5" Style="{StaticResource KeyboardKeyButtonStyle}" />
                <Button Command="{Binding NumericKeyCommand}" CommandParameter="6" Content="6" Style="{StaticResource KeyboardKeyButtonStyle}" />
                <Button Command="{Binding NumericClearCommand}" Content="전체 지우기" Style="{StaticResource KeyboardKeyButtonStyle}" />
            </UniformGrid>
            <UniformGrid Grid.Row="3" Columns="4">
                <Button Command="{Binding NumericKeyCommand}" CommandParameter="1" Content="1" Style="{StaticResource KeyboardKeyButtonStyle}" />
                <Button Command="{Binding NumericKeyCommand}" CommandParameter="2" Content="2" Style="{StaticResource KeyboardKeyButtonStyle}" />
                <Button Command="{Binding NumericKeyCommand}" CommandParameter="3" Content="3" Style="{StaticResource KeyboardKeyButtonStyle}" />
                <Button Command="{Binding NumericKeyCommand}" CommandParameter="00" Content="00" Style="{StaticResource KeyboardKeyButtonStyle}" />
            </UniformGrid>
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Margin="3" Command="{Binding NumericKeyCommand}" CommandParameter="0" Content="0" Style="{StaticResource KeyboardKeyButtonStyle}" />
                <Button Grid.Column="1" Margin="3" Command="{Binding NumericClearCommand}" Content="C" Style="{StaticResource KeyboardKeyButtonStyle}" />
                <Button Grid.Column="2" Margin="3" Command="{Binding ConfirmInputCommand}" Content="완료" Style="{StaticResource KeyboardActionButtonStyle}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
