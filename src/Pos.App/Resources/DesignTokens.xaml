<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Genesis color system -->
    <Color x:Key="ColorPrimary">#6366F1</Color>
    <Color x:Key="ColorPrimaryHover">#4F46E5</Color>
    <Color x:Key="ColorPrimaryPressed">#4338CA</Color>
    <Color x:Key="ColorNeutral">#9C9C9C</Color>
    <Color x:Key="ColorBackground">#FAFAFA</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSurfaceMuted">#F4F4F5</Color>
    <Color x:Key="ColorTextPrimary">#0A0A0A</Color>
    <Color x:Key="ColorTextSecondary">#6B6B6B</Color>
    <Color x:Key="ColorBorder">#E8E8EC</Color>
    <Color x:Key="ColorSuccess">#10B981</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>
    <Color x:Key="ColorError">#EF4444</Color>
    <Color x:Key="ColorOnPrimary">#FFFFFF</Color>

    <SolidColorBrush x:Key="BrushPrimary" Color="{StaticResource ColorPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryHover" Color="{StaticResource ColorPrimaryHover}" />
    <SolidColorBrush x:Key="BrushPrimaryPressed" Color="{StaticResource ColorPrimaryPressed}" />
    <SolidColorBrush x:Key="BrushNeutral" Color="{StaticResource ColorNeutral}" />
    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceMuted" Color="{StaticResource ColorSurfaceMuted}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushSuccess" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushError" Color="{StaticResource ColorError}" />
    <SolidColorBrush x:Key="BrushOnPrimary" Color="{StaticResource ColorOnPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryTint" Color="#EEF2FF" />
    <SolidColorBrush x:Key="BrushSuccessTint" Color="#ECFDF5" />
    <SolidColorBrush x:Key="BrushWarningTint" Color="#FFFBEB" />
    <SolidColorBrush x:Key="BrushErrorTint" Color="#FEF2F2" />

    <!-- Local Korean-capable fallbacks keep rendering deterministic offline. -->
    <FontFamily x:Key="FontDisplay">General Sans, Malgun Gothic, Segoe UI</FontFamily>
    <FontFamily x:Key="FontBody">DM Sans, Malgun Gothic, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">JetBrains Mono, D2Coding, Consolas</FontFamily>

    <sys:Double x:Key="FontSizePageTitle">28</sys:Double>
    <sys:Double x:Key="FontSizeSectionTitle">20</sys:Double>
    <sys:Double x:Key="FontSizeSubhead">17</sys:Double>
    <sys:Double x:Key="FontSizeBody">15</sys:Double>
    <sys:Double x:Key="FontSizeSmall">13</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>

    <!-- Four-DIP spacing scale -->
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space20">20</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>
    <sys:Double x:Key="Space32">32</sys:Double>
    <sys:Double x:Key="Space40">40</sys:Double>
    <sys:Double x:Key="Space48">48</sys:Double>

    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="PanelPadding">20</Thickness>
    <Thickness x:Key="ControlPadding">16,0</Thickness>
    <Thickness x:Key="CompactControlPadding">12,0</Thickness>
    <Thickness x:Key="FieldLabelMargin">0,0,0,8</Thickness>

    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusControl">6</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">8</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <sys:Double x:Key="TouchTargetMin">48</sys:Double>
    <sys:Double x:Key="TouchTargetLarge">56</sys:Double>
    <sys:Double x:Key="QuickAddTileMinHeight">88</sys:Double>
</ResourceDictionary>
