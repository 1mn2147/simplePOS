<Window x:Class="Pos.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Pos.App.Views"
        xmlns:vm="clr-namespace:Pos.App.ViewModels"
        mc:Ignorable="d"
        Title="Simple POS"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}"
        PreviewTextInput="OnPreviewTextInput"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainPageViewModel}"><views:MainPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductListViewModel}"><views:ProductListPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductEditorViewModel}"><views:ProductEditorPage /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsPage /></DataTemplate>
    </Window.Resources>
    <ContentControl Content="{Binding CurrentPage}" />
</Window>
